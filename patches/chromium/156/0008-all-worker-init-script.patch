ShadowEdge: depends on 0003-serviceworker-init-script.patch.
--- a/third_party/blink/renderer/core/workers/worker_global_scope.cc
+++ b/third_party/blink/renderer/core/workers/worker_global_scope.cc
@@ -766,12 +766,13 @@
       task_attribution_resource_timing_scope =
           SetTaskStateVariable(resource_timing_context, GetExecutionContext());
     }
-    // ShadowEdge: ServiceWorker global scopes cannot be reached by
-    // renderer-level init scripts; evaluate the kernel-provided init script
