 #include "base/command_line.h"
+#include "base/json/json_reader.h"
 #include "base/debug/leak_annotations.h"
 #include "base/feature_list.h"
 #include "base/functional/bind.h"
@@ -503,6 +505,26 @@ BrowserMainLoop::~BrowserMainLoop() {
 void BrowserMainLoop::Init() {
   TRACE_EVENT0("startup", "BrowserMainLoop::Init");
 
+  // ShadowEdge: a malformed fingerprint portrait must abort startup here,
+  // rather than letting a half-configured identity reach any page.
+  {
+    const base::CommandLine& command_line =
+        *base::CommandLine::ForCurrentProcess();
+    if (command_line.HasSwitch(switches::kShadowEdgeFingerprint)) {
+      std::string decoded;
+      bool decoded_ok = base::Base64Decode(
+          command_line.GetSwitchValueASCII(switches::kShadowEdgeFingerprint),
+          &decoded, base::Base64DecodePolicy::kForgiving);
+      std::optional<base::DictValue> portrait =
+          decoded_ok
+              ? base::JSONReader::ReadDict(decoded, base::JSON_PARSE_RFC)
+              : std::nullopt;
+      CHECK(decoded_ok && portrait.has_value())
+          << "FATAL: --shadowedge-fingerprint is not a base64-encoded JSON "
+             "object; refusing to start";
+    }
+  }
+
   if (parameters_.startup_data) {
     StartupDataImpl* startup_data =
         static_cast<StartupDataImpl*>(parameters_.startup_data.get());
