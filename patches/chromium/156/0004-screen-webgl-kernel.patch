diff --git a/third_party/blink/renderer/platform/shadowedge_fingerprint.h b/third_party/blink/renderer/platform/shadowedge_fingerprint.h
new file mode 100644
index 0000000000..16bccbfc76
--- /dev/null
+++ b/third_party/blink/renderer/platform/shadowedge_fingerprint.h
@@ -0,0 +1,67 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_SHADOWEDGE_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_SHADOWEDGE_FINGERPRINT_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/values.h"
+
+// ShadowEdge 内核画像访问器（T15，header-only 以免改动 BUILD.gn）。
+// 画像由 0001 的 --shadowedge-fingerprint 开关经浏览器进程下发到每个 renderer；
+// Blink 不能依赖 //content，开关名用本地字面量镜像。
+// 无画像或字段缺失时一律返回 nullopt，调用方回退原生行为。
+namespace blink::shadowedge {
+
+namespace internal {
+
+inline const base::DictValue* PortraitDict() {
+  static const base::NoDestructor<std::optional<base::DictValue>> portrait([] {
+    const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+    if (!cmd.HasSwitch("shadowedge-fingerprint"))
+      return std::optional<base::DictValue>(std::nullopt);
+    std::string decoded;
+    if (!base::Base64Decode(cmd.GetSwitchValueASCII("shadowedge-fingerprint"),
+                            &decoded, base::Base64DecodePolicy::kForgiving))
+      return std::optional<base::DictValue>(std::nullopt);
+    auto dict = base::JSONReader::ReadDict(decoded, base::JSON_PARSE_RFC);
+    return dict ? std::optional<base::DictValue>(std::move(*dict))
+                : std::nullopt;
+  }());
+  return portrait->has_value() ? &portrait->value() : nullptr;
+}
+
+}  // namespace internal
+
+inline std::optional<std::string> GetString(std::string_view dotted_path) {
+  const auto* dict = internal::PortraitDict();
+  if (!dict)
+    return std::nullopt;
+  const std::string* value = dict->FindStringByDottedPath(dotted_path);
+  return value ? std::optional<std::string>(*value) : std::nullopt;
+}
+
+// 与 packages/fingerprint inject.ts 的 fnv1a 逐位一致（32 位 FNV-1a）。
+inline uint32_t Fnv1a(std::string_view input) {
+  uint32_t hash = 0x811c9dc5u;
+  for (char c : input) {
+    hash ^= static_cast<uint8_t>(c);
+    hash *= 0x01000193u;
+  }
+  return hash;
+}
+
+inline std::optional<int> GetInt(std::string_view dotted_path) {
+  const auto* dict = internal::PortraitDict();
+  if (!dict)
+    return std::nullopt;
+  return dict->FindIntByDottedPath(dotted_path);
+}
+
+}  // namespace blink::shadowedge
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_SHADOWEDGE_FINGERPRINT_H_
