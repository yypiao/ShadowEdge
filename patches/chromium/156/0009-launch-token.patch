+bool ValidateShadowEdgeLaunchAuthorization() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  std::unique_ptr<base::Environment> environment = base::Environment::Create();
+  std::optional<std::string> kek_hex =
+      environment ? environment->GetVar("SHADOWEDGE_LAUNCH_KEK") : std::nullopt;
+  // The key is needed only by the browser process during this early check.
+  // Do not propagate it to subsequently launched renderer/GPU/utility
+  // processes.
+  if (environment) {
+    environment->UnSetVar("SHADOWEDGE_LAUNCH_KEK");
+  }
+  if (!kek_hex || !command_line.HasSwitch(switches::kShadowEdgeLaunchToken)) {
+    return false;
+  }
+
+  std::vector<uint8_t> kek_bytes;
+  if (!base::HexStringToBytes(*kek_hex, &kek_bytes) || kek_bytes.size() != 32) {
+    return false;
+  }
+  std::string token_json;
+  if (!base::Base64Decode(
+          command_line.GetSwitchValueASCII(switches::kShadowEdgeLaunchToken),
+          &token_json, base::Base64DecodePolicy::kForgiving)) {
+    return false;
+  }
+  std::optional<base::DictValue> envelope =
+      base::JSONReader::ReadDict(token_json, base::JSON_PARSE_RFC);
+  if (!envelope || envelope->FindInt("v") != 1) {
+    return false;
+  }
+
+  std::string wrapped_key;
+  std::string ciphertext;
+  std::string iv;
+  if (!DecodeLaunchTokenField(*envelope, "wrappedKey", &wrapped_key) ||
+      !DecodeLaunchTokenField(*envelope, "ciphertext", &ciphertext) ||
+      !DecodeLaunchTokenField(*envelope, "iv", &iv) ||
+      wrapped_key.size() != 60 || iv.size() != 12 || ciphertext.size() < 16) {
+    return false;
+  }
+
+  // EnvelopeCrypto stores wrappedKey as ciphertext || tag || wrap-IV.
+  const std::string wrapped_ciphertext_and_tag = wrapped_key.substr(0, 48);
+  const std::string wrap_iv = wrapped_key.substr(48);
+  const std::string aad = "auth-token";
+  // EnvelopeCrypto authenticates the payload with its purpose, but the DEK
+  // wrapping operation intentionally has no AAD for compatibility.
+  std::optional<std::string> dek =
+      OpenAes256Gcm(kek_bytes, wrap_iv, "", wrapped_ciphertext_and_tag);
+  if (!dek || dek->size() != 32) {
+    return false;
+  }
+  std::optional<std::string> payload_json =
+      OpenAes256Gcm(base::as_byte_span(*dek), iv, aad, ciphertext);
+  if (!payload_json) {
+    return false;
+  }
+
+  std::optional<base::DictValue> payload =
+      base::JSONReader::ReadDict(*payload_json, base::JSON_PARSE_RFC);
+  if (!payload || payload->FindInt("v") != 1) {
+    return false;
+  }
+  const std::string* profile_id = payload->FindString("profileId");
+  const std::string* nonce = payload->FindString("nonce");
+  const std::optional<int> issued_at = payload->FindInt("iat");
+  const std::optional<int> expires_at = payload->FindInt("exp");
+  if (!profile_id || profile_id->empty() || !nonce || nonce->size() < 16 ||
+      !issued_at || !expires_at) {
+    return false;
+  }
+  const double now = static_cast<double>(base::Time::Now().ToTimeT());
+  return *issued_at <= now + 5 && *expires_at > now &&
+         *expires_at > *issued_at && *expires_at - *issued_at <= 60;
+}
