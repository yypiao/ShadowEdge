+bool DecodeLaunchTokenField(const base::DictValue& envelope,
+                            std::string_view key,
+                            std::string* decoded) {
+  const std::string* value = envelope.FindString(key);
+  return value && base::Base64Decode(*value, decoded,
+                                     base::Base64DecodePolicy::kForgiving);
+}
+
+std::optional<std::string> OpenAes256Gcm(
+    base::span<const uint8_t> key,
+    const std::string& nonce,
+    const std::string& aad,
+    const std::string& ciphertext_and_tag) {
+  if (key.size() != 32 || nonce.size() != 12 ||
+      ciphertext_and_tag.size() < 16) {
+    return std::nullopt;
+  }
+  bssl::ScopedEVP_CIPHER_CTX context;
+  int output_length = 0;
+  if (!EVP_DecryptInit_ex(context.get(), EVP_aes_256_gcm(), nullptr, nullptr,
+                          nullptr) ||
+      !EVP_CIPHER_CTX_ctrl(context.get(), EVP_CTRL_GCM_SET_IVLEN,
+                           static_cast<int>(nonce.size()), nullptr) ||
+      !EVP_DecryptInit_ex(context.get(), nullptr, nullptr, key.data(),
+                          reinterpret_cast<const uint8_t*>(nonce.data())) ||
+      !EVP_DecryptUpdate(context.get(), nullptr, &output_length,
+                         reinterpret_cast<const uint8_t*>(aad.data()),
+                         static_cast<int>(aad.size()))) {
+    return std::nullopt;
+  }
+
+  const size_t ciphertext_size = ciphertext_and_tag.size() - 16;
+  std::string plaintext(ciphertext_size, '\0');
+  if (!EVP_DecryptUpdate(
+          context.get(), reinterpret_cast<uint8_t*>(plaintext.data()),
+          &output_length,
+          reinterpret_cast<const uint8_t*>(ciphertext_and_tag.data()),
+          static_cast<int>(ciphertext_size))) {
+    return std::nullopt;
+  }
+  const int plaintext_length = output_length;
+  void* tag = const_cast<uint8_t*>(
+      base::as_byte_span(ciphertext_and_tag).subspan(ciphertext_size).data());
+  int final_length = 0;
+  if (!EVP_CIPHER_CTX_ctrl(context.get(), EVP_CTRL_GCM_SET_TAG, 16, tag) ||
+      !EVP_DecryptFinal_ex(context.get(),
+                           base::as_writable_byte_span(plaintext)
+                               .subspan(static_cast<size_t>(plaintext_length))
+                               .data(),
+                           &final_length)) {
+    return std::nullopt;
+  }
+  plaintext.resize(static_cast<size_t>(plaintext_length + final_length));
+  return plaintext;
+}
