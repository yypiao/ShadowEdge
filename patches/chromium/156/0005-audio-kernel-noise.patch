@@ -123,6 +123,8 @@ class MODULES_EXPORT AudioBuffer final : public ScriptWrappable {
   uint32_t length_;
 
   HeapVector<Member<DOMFloat32Array>> channels_;
+  // ShadowEdge：确定性噪声只在首次读取时叠加一次，避免重复调用累积漂移。
+  bool shadowedge_noise_applied_ = false;
 };
 
