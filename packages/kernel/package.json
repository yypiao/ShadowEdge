{
  "name": "@shadowedge/kernel",
  "version": "0.1.0",
  "private": true,
  "description": "浏览器内核适配层：启动、隔离、CDP 会话与补丁注入",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shadowedge/core": "workspace:*",
    "@shadowedge/fingerprint": "workspace:*",
    "@shadowedge/proxy": "workspace:*",
    "patchright": "^1.64.1"
  }
}
